# ==============================================================================
# Custom Teamwear — Bulk Order WhatsApp Bot Environment Configuration
# ==============================================================================
# Copy this file to `.env.local` for local development (never commit .env.local).
# All required variables must also be configured in Vercel Project Settings -> Environment Variables.
#
# AGENTS.md Invariant #4: Environment variables are validated on cold start (src/config/env.ts).
# Missing required variables will cause fail-fast termination.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Channel Configuration
# ------------------------------------------------------------------------------
# Must strictly be "whatsapp".
CHANNEL=whatsapp

# ------------------------------------------------------------------------------
# 2. Meta WhatsApp Cloud API (or Tech Provider / BSP such as Emovur)
# ------------------------------------------------------------------------------
# Permanent System User Access Token generated from Meta Business Suite (System Users).
# NEVER use a temporary 24-hour developer token in production.
META_API_TOKEN=your-meta-system-user-api-token

# WhatsApp Phone Number ID (from Meta App Dashboard -> WhatsApp -> API Setup).
META_PHONE_NUMBER_ID=your-meta-phone-number-id

# WhatsApp Business Account (WABA) ID (from Meta Business Suite -> Accounts -> WhatsApp Accounts).
META_BUSINESS_ACCOUNT_ID=your-meta-business-account-id

# Webhook verification secret token. You choose this string and register the exact same
# value in Meta App Dashboard / Emovur Webhook configuration.
META_WEBHOOK_SECRET=choose-a-long-random-32-byte-hex-or-string

# Outbound WhatsApp Cloud API Base URL:
# - Direct Meta Cloud API: https://graph.facebook.com
# - Emovur Tech Provider:  https://metagraph.backendprod.com
META_API_BASE_URL=https://graph.facebook.com

# Meta App Secret — used to verify X-Hub-Signature-256 HMAC-SHA256 signature on inbound POSTs.
# Obtain from Meta App Dashboard -> Settings -> Basic -> App Secret.
META_APP_SECRET=your-meta-app-secret

# Display phone number from the Meta WABA (informational for team reference).
META_PHONE_DISPLAY=+919876543210

# Tech Provider connector ID (optional, informational if using a BSP like Emovur).
EMOVUR_CONNECTOR_ID=

# ------------------------------------------------------------------------------
# 3. Admin WhatsApp Notifications & Email Approval Portal
# ------------------------------------------------------------------------------
# Comma-separated list of WhatsApp phone numbers / chat IDs that receive admin order cards.
# Can be formatted as `wa:919876543210` or plain digits `919876543210`.
ADMIN_CHAT_IDS=wa:919876543210,wa:919876543211

# Comma-separated admin email addresses that receive new order alerts and 6-digit approval OTPs.
# Defaults to "cteamwear@gmail.com" if omitted.
ADMIN_EMAILS=cteamwear@gmail.com,owner@yourdomain.com

# Resend API key (re_...) for transactional order alert emails & OTP verification codes.
# Get from https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here

# Sender email address. Must use a domain verified in Resend (or onboarding@resend.dev for testing).
ADMIN_EMAIL_FROM=Custom Teamwear <orders@yourdomain.com>

# Dedicated secret used to HMAC-sign 7-day admin approval portal URLs (/api/admin-approve).
# AGENTS.md invariant: NO hardcoded default is allowed (CB-04). Provide a strong random secret.
ADMIN_PORTAL_SECRET=choose-a-strong-32-character-secret-for-portal-hmac

# ------------------------------------------------------------------------------
# 4. UPI Payment & Banking Configuration
# ------------------------------------------------------------------------------
# Merchant Virtual Payment Address (VPA) for dynamic UPI QR code generation (50% advance).
MERCHANT_VPA=yourbusiness@upi

# Publicly accessible HTTPS URL to your static brand UPI QR image (used as a fallback in quote cards).
STATIC_QR_URL=https://your-public-cdn.com/static-qr.png

# ------------------------------------------------------------------------------
# 5. Upstash Redis (Session Drafts, Locks, Quotas & Deduplication)
# ------------------------------------------------------------------------------
# Upstash Redis REST endpoint and bearer token from https://console.upstash.com
REDIS_REST_URL=https://your-database-name.upstash.io
REDIS_REST_TOKEN=your-upstash-redis-rest-token

# ------------------------------------------------------------------------------
# 6. Google Cloud & Google Sheets CRM
# ------------------------------------------------------------------------------
# Google Service Account JSON containing "client_email" and "private_key".
# Paste as a single-line JSON string. Ensure this service account has Editor access to SHEET_ID.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com"}

# Google Sheet ID extracted from the spreadsheet URL:
# https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit
# The sheet MUST contain 3 tabs: "Orders", "CatalogSelections", and "MockupGenerations".
SHEET_ID=your-google-sheet-id-from-url

# ------------------------------------------------------------------------------
# 7. Durable Storage (Vercel Blob)
# ------------------------------------------------------------------------------
# Read/Write token for Vercel Blob store where customer logos and generated mockups are saved.
# Auto-populated by Vercel when linking a Blob store; set locally for `vercel dev`.
# Storage is MANDATORY for mockup proofs: customer mockups cannot be delivered if unset.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your_blob_token_here

# ------------------------------------------------------------------------------
# 8. Photorealistic AI Mockup Generation Engine
# ------------------------------------------------------------------------------
# Active AI provider: "openai" (tested production default), "openrouter", or "gemini".
MOCKUP_IMAGE_PROVIDER=openai

# OpenAI API key (from https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-proj-your-openai-api-key

# AI Image model name (default: gpt-image-2.5-flare-2026-09-08)
MOCKUP_IMAGE_MODEL=gpt-image-2.5-flare-2026-09-08

# Alternative providers (only required if MOCKUP_IMAGE_PROVIDER is changed from openai):
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Dedicated secret protecting the background worker endpoint (/api/mockup-delivery).
# Decouples 30-60s AI image generation from the webhook timeout budget (waitUntil).
# MUST be a separate value from META_WEBHOOK_SECRET for security isolation.
INTERNAL_MOCKUP_SECRET=choose-a-strong-random-mockup-delivery-secret

# Base deployment URL used for internal API dispatch (optional; falls back to Vercel system env vars).
PUBLIC_BASE_URL=https://custom-teamwear-bot.vercel.app

# ------------------------------------------------------------------------------
# 9. Business & Quota Rules
# ------------------------------------------------------------------------------
# Free AI mockup generations allowed per user per Asia/Kolkata calendar month (default: 3).
MOCKUP_FREE_PER_MONTH=3

# Cost in Indian Rupees (INR) charged per mockup generation once monthly free quota is exhausted (default: 20).
MOCKUP_PAID_PRICE_INR=20

# ------------------------------------------------------------------------------
# 10. Scheduled Tasks & Cron Security
# ------------------------------------------------------------------------------
# Secret protecting the daily heartbeat cron endpoint (/api/heartbeat).
# Vercel sends `Authorization: Bearer <CRON_SECRET>` automatically when configured in project settings.
CRON_SECRET=choose-a-cron-bearer-token

# ------------------------------------------------------------------------------
# 11. Observability & Error Monitoring (Optional)
# ------------------------------------------------------------------------------
# Sentry DSN for error telemetry and exception alerts (leave empty to disable Sentry).
SENTRY_DSN=
